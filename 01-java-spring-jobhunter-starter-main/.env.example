# ==========================================
# ENV TEMPLATE FOR JOBHUNTER APPLICATION
# Sao chép file này thành .env để cấu hình local/production
# ==========================================

# Active profile: 'dev' hoặc 'prod'
SPRING_PROFILES_ACTIVE=dev

# Server Config
SERVER_PORT=8080

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/jobhunter?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# JWT Security (Key Base64 tối thiểu 64 bytes)
JWT_SECRET=your_base64_secret_key_here
JWT_ACCESS_TOKEN_VALIDITY=86400
JWT_REFRESH_TOKEN_VALIDITY=864000

# Mail Configuration (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# File Storage Configuration
UPLOAD_BASE_URI=file:///D:/upload/
